@{
    ViewData["Title"] = "Agent Portal - Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Agent Login - HelpDesk</title>
    <!-- Fonts & Icons -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
        :root {
            --glass-bg: rgba(255, 248, 220, 0.07);
            --glass-border: rgba(255, 215, 80, 0.22);
            --glass-shadow: 0 16px 40px 0 rgba(0, 0, 0, 0.5);
            --text-primary: #fff8e7;
            --text-secondary: #c8a96e;
            --accent-gold: #f59e0b;
            --accent-amber: #d97706;
            --accent-yellow: #fcd34d;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        body {
            min-height: 100vh;
            background: radial-gradient(circle at 20% 20%, #3b2400 0%, #1c1200 45%, #0a0800 100%);
            color: var(--text-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            overflow: hidden;
            position: relative;
        }

        /* Ambient Glowing Background Orbs - Yellow/Amber theme */
        .ambient-orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            z-index: 0;
            pointer-events: none;
            opacity: 0.55;
            animation: floatOrb 18s ease-in-out infinite alternate;
        }
        .orb-1 {
            width: 460px;
            height: 460px;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            top: -120px;
            left: -120px;
        }
        .orb-2 {
            width: 400px;
            height: 400px;
            background: linear-gradient(135deg, #fbbf24, #f97316);
            bottom: -100px;
            right: -80px;
        }
        .orb-3 {
            width: 280px;
            height: 280px;
            background: linear-gradient(135deg, #fcd34d, #f59e0b);
            top: 45%;
            right: 15%;
            opacity: 0.25;
        }
        @@keyframes floatOrb {
            0% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(40px, 30px) scale(1.1); }
            100% { transform: translate(-30px, 50px) scale(0.95); }
        }

        /* Glass Card - Yellowish tint */
        .login-card {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 440px;
            background: rgba(255, 220, 80, 0.06);
            backdrop-filter: blur(32px);
            -webkit-backdrop-filter: blur(32px);
            border: 1px solid rgba(255, 210, 60, 0.25);
            border-radius: 28px;
            box-shadow: var(--glass-shadow), 0 0 60px rgba(245, 158, 11, 0.12);
            padding: 40px 36px;
            display: flex;
            flex-direction: column;
            gap: 24px;
        }

        /* Golden top accent line */
        .login-card::before {
            content: '';
            position: absolute;
            top: 0; left: 10%; right: 10%;
            height: 2px;
            background: linear-gradient(90deg, transparent, #f59e0b, #fcd34d, #f59e0b, transparent);
            border-radius: 2px;
        }

        .brand-header {
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
        }
        .brand-icon {
            width: 62px;
            height: 62px;
            border-radius: 20px;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            color: #fff;
            box-shadow: 0 8px 28px rgba(245, 158, 11, 0.55);
            border: 1px solid rgba(255, 220, 80, 0.45);
        }
        .brand-header h1 {
            font-size: 1.45rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            color: #fef3c7;
        }
        .brand-header p {
            font-size: 0.86rem;
            color: var(--text-secondary);
        }

        /* Form Inputs */
        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .form-label {
            font-size: 0.82rem;
            font-weight: 500;
            color: #fde68a;
        }
        .input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }
        .input-icon {
            position: absolute;
            left: 16px;
            color: #f59e0b;
            font-size: 17px;
        }
        .glass-input {
            width: 100%;
            background: rgba(255, 220, 60, 0.06);
            border: 1px solid rgba(255, 200, 50, 0.22);
            border-radius: 16px;
            padding: 14px 16px 14px 46px;
            font-size: 0.95rem;
            color: #fff8e7;
            outline: none;
            transition: all 0.25s ease;
        }
        .glass-input::placeholder { color: rgba(255, 220, 100, 0.35); }
        .glass-input:focus {
            background: rgba(255, 220, 60, 0.12);
            border-color: #f59e0b;
            box-shadow: 0 0 18px rgba(245, 158, 11, 0.28);
        }

        .login-btn {
            width: 100%;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            border: 1px solid rgba(255, 230, 80, 0.4);
            color: #1c1200;
            padding: 14px;
            border-radius: 16px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.25s ease;
            box-shadow: 0 4px 20px rgba(245, 158, 11, 0.45);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-top: 6px;
        }
        .login-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 28px rgba(245, 158, 11, 0.6);
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
        }

        .alert-error {
            background: rgba(239, 68, 68, 0.15);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #fca5a5;
            padding: 12px 16px;
            border-radius: 14px;
            font-size: 0.84rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        /* Demo credentials card */
        .demo-box {
            background: rgba(255, 200, 50, 0.05);
            border: 1px solid rgba(255, 200, 50, 0.15);
            border-radius: 14px;
            padding: 12px 14px;
            font-size: 0.78rem;
            color: var(--text-secondary);
        }
        .demo-title {
            color: var(--accent-yellow);
            font-weight: 600;
            margin-bottom: 4px;
        }
        .demo-pill {
            display: inline-block;
            background: rgba(255, 200, 50, 0.12);
            border: 1px solid rgba(255, 200, 50, 0.2);
            padding: 3px 8px;
            border-radius: 6px;
            font-family: monospace;
            color: #fef3c7;
            margin: 2px 0;
            cursor: pointer;
        }
        .demo-pill:hover { background: rgba(255, 200, 50, 0.22); }

        .back-link {
            text-align: center;
            font-size: 0.82rem;
            color: var(--text-secondary);
            text-decoration: none;
            transition: color 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .back-link:hover {
            color: #fcd34d;
        }
        /* =====================================================================
           MOBILE RESPONSIVE STYLES - Login Page
           ===================================================================== */

        /* --- 768px: Tablet --- */
        @@media (max-width: 768px) {
            body {
                padding: 16px;
                overflow-y: auto;
                overflow-x: hidden;
                align-items: flex-start;
            }
            /* Ensure card doesn't get clipped on landscape */
            .login-card {
                padding: 32px 28px;
                border-radius: 22px;
                margin: 0 auto;
            }
        }

        /* --- 480px: Small phones --- */
        @@media (max-width: 480px) {
            body {
                padding: 12px;
                overflow-y: auto;
                align-items: flex-start;
            }
            /* Compact login card */
            .login-card {
                padding: 24px 18px;
                border-radius: 18px;
                gap: 18px;
                max-width: 100%;
            }
            /* Smaller brand */
            .brand-header h1 { font-size: 1.18rem; }
            .brand-header p { font-size: 0.8rem; }
            .brand-icon {
                width: 52px;
                height: 52px;
                font-size: 24px;
                border-radius: 16px;
            }
            /* Inputs */
            .glass-input {
                font-size: 0.9rem;
                padding: 12px 14px 12px 42px;
            }
            /* Sign-in button */
            .login-btn {
                padding: 13px;
                font-size: 0.95rem;
            }
            /* Demo box: make credential rows wrap nicely */
            .demo-box {
                font-size: 0.74rem;
                padding: 10px 12px;
            }
            /* Demo pill rows: allow wrapping on tiny screens */
            .demo-box > div > div {
                flex-wrap: wrap;
                gap: 4px;
            }
            /* Orbs: shrink to avoid layout blowout on mobile */
            .orb-1 { width: 240px; height: 240px; }
            .orb-2 { width: 200px; height: 200px; }
            .orb-3 { width: 150px; height: 150px; }
        }

        /* --- 360px: Very small phones (Galaxy A01, older Androids) --- */
        @@media (max-width: 360px) {
            .login-card { padding: 20px 14px; gap: 14px; }
            .brand-header h1 { font-size: 1rem; }
            .glass-input { font-size: 0.85rem; }
        }
    </style>
</head>
<body>

    <!-- Ambient Orbs - Golden/Amber theme -->
    <div class="ambient-orb orb-1"></div>
    <div class="ambient-orb orb-2"></div>
    <div class="ambient-orb orb-3"></div>
    <div class="ambient-orb orb-1"></div>
    <div class="ambient-orb orb-2"></div>

    <div class="login-card">
        <div class="brand-header">
            <div class="brand-icon">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h1>Live Agent Portal</h1>
            <p>Login to accept student chats & reply in real-time</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-error">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span>@ViewBag.Error</span>
            </div>
        }

        <form method="post" action="/Account/Login">
            <div style="display: flex; flex-direction: column; gap: 16px;">
                <div class="form-group">
                    <label class="form-label">Agent Email</label>
                    <div class="input-wrap">
                        <i class="bi bi-envelope-fill input-icon"></i>
                        <input type="email" name="Email" id="emailInput" class="glass-input" placeholder="agent@mvvu.ac.in" required value="amit@mvvu.ac.in" />
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Password</label>
                    <div class="input-wrap">
                        <i class="bi bi-key-fill input-icon"></i>
                        <input type="password" name="Password" id="passwordInput" class="glass-input" placeholder="••••••••" required value="Admin@123" />
                    </div>
                </div>

                <button type="submit" class="login-btn">
                    <span>Sign In to Dashboard</span>
                    <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </form>

        <div class="demo-box">
            <div class="demo-title"><i class="bi bi-people-fill"></i> Select Demo Agent (Click to auto-fill):</div>
            <div style="display:flex; flex-direction:column; gap:6px; margin-top:6px;">
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span>🟢 Amit (Senior - Emerald)</span>
                    <span class="demo-pill" onclick="fillCreds('amit@mvvu.ac.in','Admin@123')">Select</span>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span>🟣 Priya (Support - Purple)</span>
                    <span class="demo-pill" onclick="fillCreds('priya@mvvu.ac.in','Agent@123')">Select</span>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span>🔵 Rahul (Tech - Cyan)</span>
                    <span class="demo-pill" onclick="fillCreds('rahul@mvvu.ac.in','Agent@123')">Select</span>
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span>🟠 Neha (HelpDesk - Amber)</span>
                    <span class="demo-pill" onclick="fillCreds('neha@mvvu.ac.in','Agent@123')">Select</span>
                </div>
            </div>
        </div>

        <a href="/" class="back-link">
            <i class="bi bi-arrow-left"></i> Back to Student ChatBot
        </a>
    </div>

    <script>
        function fillCreds(email, pass) {
            document.getElementById('emailInput').value = email;
            document.getElementById('passwordInput').value = pass;
        }
    </script>
</body>
</html>
